APP_NAME="Sagansa Document Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://document.sagansa.id

# Domain publik service document (QR tanda tangan / verifikasi dokumen)
DOCUMENT_DOMAIN=https://document.sagansa.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database default service document (sagansa_document) - master surat,
# template, penomoran, dan tabel domain service ini
DB_CONNECTION=mysql_document
DB_DOCUMENT_HOST=127.0.0.1
DB_DOCUMENT_PORT=3306
DB_DOCUMENT_DATABASE=sagansa_document
DB_DOCUMENT_USERNAME=root
DB_DOCUMENT_PASSWORD=

# Koneksi ke sagansa_user untuk validasi Sanctum token (mirror services/img)
# Token yang dikeluarkan api-ops saat login langsung valid di service ini.
DB_AUTH_HOST=127.0.0.1
DB_AUTH_PORT=3306
DB_AUTH_DATABASE=sagansa_user
DB_AUTH_USERNAME=root
DB_AUTH_PASSWORD=

# Rate limit endpoint verifikasi publik (request/menit per IP)
VERIFY_RATE_LIMIT=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
